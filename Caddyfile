# Dev local : un seul point d'entrée 127.0.0.1:4000. En prod (T38), même routage derrière TLS.
:4000 {
	encode zstd gzip
	handle /api/admin/media {
		request_body {
			max_size 6MB
		}
		reverse_proxy backend:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle /api/* {
		request_body {
			max_size 1MB
		}
		# Écrase X-Forwarded-For par l'IP réelle du client : le back ne fait confiance à aucune valeur fournie.
		reverse_proxy backend:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	# Médias téléversés (D43) : lus seulement, nom = hash du contenu donc immuable.
	handle /uploads/* {
		root * /srv
		header X-Content-Type-Options nosniff
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	redir /admin /fr/admin 302
	handle {
		reverse_proxy frontend:4000
	}
}
