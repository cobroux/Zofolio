# Caddy interne de Zofolio : en-têtes, limites de taille, /uploads et routage vers back/front.
# Le HTTPS et les ports 80/443 sont tenus par le proxy frontal partagé /opt/edge (indépendant des
# projets) qui renvoie ici le domaine de Zofolio via le réseau Docker « edge » (alias zofolio-web).
{
	auto_https off
	servers {
		# Seul le proxy frontal parle à ce Caddy : on lui fait confiance pour X-Forwarded-For,
		# ainsi {client_ip} reste la vraie IP du visiteur (limites de débit du backend).
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Angular SSR : styles critiques et script de rejeu d'événements inlinés (d'où 'unsafe-inline') ; clips et affiches en 'self'.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
		-X-Powered-By
	}

	# En premier : `handle` passe avant `respond` dans l'ordre Caddy.
	@trace method TRACE TRACK
	handle @trace {
		respond 405
	}
	handle /api/admin/media {
		request_body {
			max_size 6MB
		}
		reverse_proxy backend:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle /api/* {
		request_body {
			max_size 1MB
		}
		# Pas de proxy devant Caddy : {client_ip} = l'adresse du pair ; on écrase toute valeur fournie par le client.
		reverse_proxy backend:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle /uploads/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	redir /admin /fr/admin 302
	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy frontend:4000
	}
}
