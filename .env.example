# Copier en .env (jamais commité). Valeurs factices.
# Base de données
POSTGRES_DB=zofolio
DB_URL=jdbc:postgresql://postgres:5432/zofolio
DB_USER=zofolio
DB_PASSWORD=change-me
# SMTP (dev : mailpit ; prod : smtp.gmail.com:587 + mot de passe d'application)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
CONTACT_TO=enzo@example.com
# Sel du hash d'IP pour la limite contact
IP_HASH_SALT=change-me-random-32-chars
# SSR -> back sur le réseau Docker
API_INTERNAL_URL=http://backend:8080
# Token GitHub fine-grained, lecture seule des dépôts publics (laisser vide : pas de synchro)
GITHUB_TOKEN=
# Admin : hash bcrypt (coût >= 12) du mot de passe, ENTRE APOSTROPHES (sinon Compose interprète les $).
# Générer : docker run --rm -it caddy:2 caddy hash-password   (vide : connexion admin refusée)
ADMIN_PASSWORD_HASH='$2a$12$exempleFactice0000000000000000000000000000000000000000'
# Dossier des médias téléversés (volume partagé avec Caddy en lecture seule)
MEDIA_DIR=/data/media
# Prod Gmail : true / true
SMTP_AUTH=false
SMTP_STARTTLS=false
